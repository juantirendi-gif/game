        /* ==================== SETTINGS & PAUSE MODAL ==================== */
        #settings-modal-backdrop {
            position: fixed;
            inset: 0;
            z-index: 40;
            background: rgba(4, 6, 12, 0.78);
            backdrop-filter: blur(8px);
            display: none;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }

        #settings-modal-backdrop.open {
            display: flex;
        }

        .settings-modal {
            width: 100%;
            max-width: 760px;
            max-height: 88vh;
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }

        .modal-header {
            padding: 18px 24px;
            border-bottom: 1px solid var(--panel-border);
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .modal-body {
            padding: 20px 24px;
            overflow-y: auto;
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 18px;
        }

        .setting-group {
            background: rgba(255, 255, 255, 0.04);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 12px;
            padding: 14px;
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .setting-group h3 {
            font-size: 0.85rem;
            color: var(--accent);
            letter-spacing: 0.08em;
            text-transform: uppercase;
        }

        .setting-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            font-size: 0.85rem;
        }

        .modal-footer {
            padding: 16px 24px;
            border-top: 1px solid var(--panel-border);
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 10px;
        }

        /* ==================== RACE RESULTS MODAL ==================== */
        #results-modal-backdrop {
            position: fixed;
            inset: 0;
            z-index: 45;
            background: rgba(4, 6, 12, 0.84);
            backdrop-filter: blur(10px);
            display: none;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }

        #results-modal-backdrop.open {
            display: flex;
        }

        .results-card {
            width: 100%;
            max-width: 580px;
            padding: 26px;
            text-align: center;
        }

        .standings-table {
            width: 100%;
            border-collapse: collapse;
            margin: 16px 0;
            font-size: 0.88rem;
            text-align: left;
        }

        .standings-table th {
            padding: 8px 10px;
            color: var(--text-muted);
            border-bottom: 1px solid rgba(255,255,255,0.12);
        }

        .standings-table td {
            padding: 9px 10px;
            border-bottom: 1px solid rgba(255,255,255,0.06);
        }

        .standings-table tr.player-row {
            background: rgba(255, 59, 48, 0.18);
            font-weight: 700;
        }

        /* Toast Notification */
        #toast-container {
            position: fixed;
            bottom: 24px;
            left: 50%;
            transform: translateX(-50%);
            z-index: 60;
            display: flex;
            flex-direction: column;
            gap: 8px;
            pointer-events: none;
        }

        .toast-msg {
            padding: 10px 20px;
            border-radius: 99px;
            background: rgba(15, 22, 36, 0.94);
            border: 1px solid var(--accent);
            color: #fff;
            font-size: 0.85rem;
            font-weight: 700;
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.5);
            animation: fadeSlideUp 0.25s ease;
        }

        @keyframes fadeSlideUp {
            from { opacity: 0; transform: translateY(12px); }
            to { opacity: 1; transform: translateY(0); }
        }
    </style>
</head>
