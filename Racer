<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>APEX HORIZON | Ultimate 3D Racing Simulator</title>
    <!-- Three.js r128 from cdnjs -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <!-- Google Fonts for Motorsport Typography -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Chakra+Petch:ital,wght@0,400;0,600;0,700;1,700&family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;700;800&display=swap" rel="stylesheet">
    <style>
        :root {
            --primary: #ff3b30;
            --primary-glow: rgba(255, 59, 48, 0.5);
            --accent: #00e5ff;
            --accent-glow: rgba(0, 229, 255, 0.45);
            --gold: #ffcc00;
            --success: #30d158;
            --bg-dark: #090b10;
            --panel-bg: rgba(13, 17, 26, 0.86);
            --panel-border: rgba(255, 255, 255, 0.14);
            --text-main: #f5f7fa;
            --text-muted: #94a3b8;
            --hud-scale: 1;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            user-select: none;
            -webkit-user-select: none;
        }

        html, body {
            width: 100%;
            height: 100%;
            overflow: hidden;
            background-color: var(--bg-dark);
            color: var(--text-main);
            font-family: 'Inter', sans-serif;
        }

        .font-racing {
            font-family: 'Chakra Petch', sans-serif;
            text-transform: uppercase;
            letter-spacing: 0.04em;
        }

        .font-mono {
            font-family: 'JetBrains Mono', monospace;
        }

        /* WebGL Canvas Container */
        #game-canvas-container {
            position: fixed;
            inset: 0;
            width: 100%;
            height: 100%;
            z-index: 1;
        }

        canvas {
            display: block;
            width: 100%;
            height: 100%;
        }

        /* Windshield Rain & Speed Lines Overlay */
        #screen-fx-overlay {
            position: fixed;
            inset: 0;
            pointer-events: none;
            z-index: 5;
            overflow: hidden;
        }

        #speed-lines-canvas {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            opacity: 0;
            transition: opacity 0.2s ease;
        }

        #lightning-flash {
            position: absolute;
            inset: 0;
            background: rgba(220, 240, 255, 0.85);
            opacity: 0;
            pointer-events: none;
        }

        #cockpit-rain-overlay {
            position: absolute;
            inset: 0;
            background-image: radial-gradient(circle at 20% 30%, rgba(255,255,255,0.18) 1px, transparent 2px),
                              radial-gradient(circle at 70% 60%, rgba(255,255,255,0.22) 1.5px, transparent 3px),
                              radial-gradient(circle at 45% 80%, rgba(255,255,255,0.15) 1px, transparent 2px);
            background-size: 120px 120px, 180px 180px, 90px 90px;
            opacity: 0;
            transition: opacity 0.4s ease;
        }

        /* Glassmorphism Panels & Buttons */
        .glass-panel {
            background: var(--panel-bg);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid var(--panel-border);
            border-radius: 14px;
            box-shadow: 0 12px 40px rgba(0, 0, 0, 0.55);
        }

        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            padding: 10px 18px;
            border-radius: 10px;
            font-weight: 700;
            font-size: 0.9rem;
            cursor: pointer;
            border: 1px solid rgba(255, 255, 255, 0.16);
            background: rgba(255, 255, 255, 0.08);
            color: #fff;
            transition: all 0.16s cubic-bezier(0.22, 1, 0.36, 1);
            text-decoration: none;
        }

        .btn:hover {
            background: rgba(255, 255, 255, 0.16);
            border-color: rgba(255, 255, 255, 0.35);
            transform: translateY(-1px);
        }

        .btn:active {
            transform: translateY(1px) scale(0.98);
        }

        .btn-primary {
            background: linear-gradient(135deg, #ff3b30 0%, #d70015 100%);
            border-color: #ff6961;
            box-shadow: 0 6px 20px var(--primary-glow);
        }

        .btn-primary:hover {
            background: linear-gradient(135deg, #ff5147 0%, #e60017 100%);
            box-shadow: 0 8px 26px rgba(255, 59, 48, 0.7);
        }

        .btn-accent {
            background: linear-gradient(135deg, #00c6ff 0%, #0072ff 100%);
            border-color: #66e0ff;
            box-shadow: 0 6px 20px var(--accent-glow);
        }

        .btn-gold {
            background: linear-gradient(135deg, #ffd60a 0%, #ff9f0a 100%);
            color: #090b10;
            border-color: #ffe666;
            font-weight: 800;
        }

        /* ==================== MAIN MENU & LOBBY UI ==================== */
        #main-menu-overlay {
            position: fixed;
            inset: 0;
            z-index: 20;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            padding: 20px 28px;
            background: linear-gradient(90deg, rgba(7, 9, 14, 0.92) 0%, rgba(7, 9, 14, 0.55) 48%, rgba(7, 9, 14, 0.25) 100%);
            transition: opacity 0.35s ease, visibility 0.35s ease;
        }

        #main-menu-overlay.hidden {
            opacity: 0;
            visibility: hidden;
            pointer-events: none;
        }

        .top-nav-bar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 12px;
        }

        .brand-logo {
            display: flex;
            align-items: center;
            gap: 14px;
        }

        .brand-badge {
            background: linear-gradient(135deg, var(--primary), #ff9500);
            padding: 8px 14px;
            border-radius: 10px;
            font-weight: 900;
            font-size: 1.3rem;
            letter-spacing: 0.08em;
            box-shadow: 0 4px 16px var(--primary-glow);
        }

        .brand-title h1 {
            font-size: 1.65rem;
            font-weight: 800;
            line-height: 1;
            letter-spacing: 0.06em;
        }

        .brand-title span {
            font-size: 0.75rem;
            color: var(--accent);
            font-weight: 600;
            letter-spacing: 0.18em;
        }

        .nav-tabs {
            display: flex;
            gap: 8px;
            background: rgba(0, 0, 0, 0.45);
            padding: 6px;
            border-radius: 12px;
            border: 1px solid var(--panel-border);
        }

        .nav-tab {
            padding: 9px 16px;
            border-radius: 8px;
            font-weight: 700;
            font-size: 0.85rem;
            cursor: pointer;
            color: var(--text-muted);
            transition: all 0.15s ease;
        }

        .nav-tab:hover {
            color: #fff;
            background: rgba(255, 255, 255, 0.06);
        }

        .nav-tab.active {
            background: var(--primary);
            color: #fff;
            box-shadow: 0 4px 12px var(--primary-glow);
        }

        .player-wallet {
            display: flex;
            align-items: center;
            gap: 14px;
            padding: 8px 16px;
            border-radius: 12px;
            background: rgba(0, 0, 0, 0.55);
            border: 1px solid var(--panel-border);
        }

        .wallet-item {
            display: flex;
            flex-direction: column;
            align-items: flex-end;
        }

        .wallet-label {
            font-size: 0.65rem;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 0.08em;
        }

        .wallet-val {
            font-weight: 800;
            font-size: 1rem;
            color: var(--gold);
        }

        /* Menu Center Content Area */
        .menu-workspace {
            display: grid;
            grid-template-columns: 440px 1fr;
            gap: 24px;
            flex: 1;
            margin: 18px 0;
            min-height: 0;
        }

        @media (max-width: 1024px) {
            .menu-workspace {
                grid-template-columns: 1fr;
            }
        }

        .left-drawer {
            display: flex;
            flex-direction: column;
            padding: 20px;
            overflow-y: auto;
            max-height: 100%;
        }

        .drawer-section {
            display: none;
            flex-direction: column;
            gap: 16px;
            height: 100%;
        }

        .drawer-section.active {
            display: flex;
        }

        /* Car Selector Cards */
        .class-filter-pills {
            display: flex;
            flex-wrap: wrap;
            gap: 6px;
        }

        .filter-pill {
            padding: 5px 10px;
            font-size: 0.72rem;
            font-weight: 700;
            border-radius: 999px;
            background: rgba(255, 255, 255, 0.07);
            border: 1px solid rgba(255, 255, 255, 0.12);
            color: var(--text-muted);
            cursor: pointer;
            transition: all 0.15s;
        }

        .filter-pill.active, .filter-pill:hover {
            background: var(--accent);
            color: #060911;
            border-color: var(--accent);
        }

        .car-list-scroll {
            display: flex;
            flex-direction: column;
            gap: 8px;
            overflow-y: auto;
            padding-right: 6px;
            flex: 1;
        }

        .car-list-scroll::-webkit-scrollbar {
            width: 6px;
        }
        .car-list-scroll::-webkit-scrollbar-thumb {
            background: rgba(255, 255, 255, 0.2);
            border-radius: 3px;
        }

        .car-item-card {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 12px 14px;
            border-radius: 10px;
            background: rgba(255, 255, 255, 0.04);
            border: 1px solid rgba(255, 255, 255, 0.08);
            cursor: pointer;
            transition: all 0.15s ease;
        }

        .car-item-card:hover {
            background: rgba(255, 255, 255, 0.09);
            border-color: rgba(255, 255, 255, 0.25);
        }

        .car-item-card.selected {
            background: linear-gradient(90deg, rgba(255, 59, 48, 0.22) 0%, rgba(255, 59, 48, 0.06) 100%);
            border-color: var(--primary);
            box-shadow: 0 0 18px rgba(255, 59, 48, 0.25);
        }

        .car-item-info h4 {
            font-size: 0.95rem;
            font-weight: 700;
            margin-bottom: 2px;
        }

        .car-item-meta {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 0.72rem;
            color: var(--text-muted);
        }

        .engine-badge {
            padding: 2px 6px;
            border-radius: 4px;
            background: rgba(0, 229, 255, 0.15);
            color: var(--accent);
            font-weight: 700;
            font-family: 'JetBrains Mono', monospace;
        }

        /* Right Showcase Floating Specs */
        .right-showcase-overlay {
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            align-items: flex-end;
            pointer-events: none;
        }

        .car-specs-card {
            width: 340px;
            padding: 18px;
            pointer-events: auto;
        }

        .stat-bar-row {
            margin-bottom: 10px;
        }

        .stat-bar-header {
            display: flex;
            justify-content: space-between;
            font-size: 0.76rem;
            font-weight: 700;
            margin-bottom: 4px;
            color: #cbd5e1;
        }

        .stat-bar-track {
            height: 7px;
            background: rgba(255, 255, 255, 0.1);
            border-radius: 99px;
            overflow: hidden;
        }

        .stat-bar-fill {
            height: 100%;
            background: linear-gradient(90deg, var(--accent), #30d158);
            border-radius: 99px;
            transition: width 0.3s cubic-bezier(0.22, 1, 0.36, 1);
        }

        /* Track & Mode Selection Cards */
        .track-grid {
            display: grid;
            grid-template-columns: 1fr;
            gap: 10px;
            overflow-y: auto;
            padding-right: 4px;
        }

        .track-card {
            padding: 14px;
            border-radius: 12px;
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.1);
            cursor: pointer;
            transition: all 0.15s;
        }

        .track-card:hover {
            background: rgba(255, 255, 255, 0.1);
        }

        .track-card.selected {
            border-color: var(--accent);
            background: linear-gradient(90deg, rgba(0, 229, 255, 0.18), rgba(0, 229, 255, 0.04));
        }

        .mode-pills {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 8px;
        }

        .mode-card {
            padding: 10px 12px;
            border-radius: 10px;
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.1);
            cursor: pointer;
            text-align: left;
            transition: all 0.15s;
        }

        .mode-card.selected {
            border-color: var(--gold);
            background: rgba(255, 204, 0, 0.14);
        }

        /* Customizer Swatches & Upgrades */
        .color-swatches {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
        }

        .swatch {
            width: 28px;
            height: 28px;
            border-radius: 50%;
            cursor: pointer;
            border: 2px solid rgba(255, 255, 255, 0.3);
            transition: transform 0.15s;
        }

        .swatch:hover, .swatch.active {
            transform: scale(1.2);
            border-color: #fff;
            box-shadow: 0 0 10px rgba(255, 255, 255, 0.6);
        }

        .upgrade-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 10px 12px;
            background: rgba(255, 255, 255, 0.04);
            border-radius: 10px;
            border: 1px solid rgba(255, 255, 255, 0.08);
        }

        /* Bottom Action Footer */
        .menu-footer {
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 14px;
            padding: 14px 20px;
        }

        .quick-weather-bar {
            display: flex;
            align-items: center;
            gap: 10px;
            flex-wrap: wrap;
        }

        select, input[type="range"] {
            accent-color: var(--primary);
        }

        .styled-select {
            background: rgba(15, 20, 32, 0.9);
            color: #fff;
            border: 1px solid rgba(255, 255, 255, 0.2);
            padding: 8px 12px;
            border-radius: 8px;
            font-size: 0.85rem;
            font-weight: 600;
            outline: none;
            cursor: pointer;
        }

        /* ==================== IN-GAME INTERACTIVE SCALABLE HUD ==================== */
        #racing-hud-wrapper {
            position: fixed;
            inset: 0;
            z-index: 15;
            pointer-events: none;
            display: none;
        }

        #racing-hud-wrapper.active {
            display: block;
        }

        /* Scalable HUD Layer */
        #hud-scalable-layer {
            position: absolute;
            inset: 0;
            transform-origin: center center;
            pointer-events: none;
        }

        .hud-interactive {
            pointer-events: auto;
        }

        /* Top Bar: Position, Lap, Timer, Interactive Quick Actions */
        .hud-top-bar {
            position: absolute;
            top: 16px;
            left: 16px;
            right: 16px;
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 12px;
            transform-origin: top center;
            transform: scale(var(--hud-scale));
        }

        .hud-telemetry-box {
            display: flex;
            align-items: center;
            gap: 16px;
            padding: 10px 18px;
            background: rgba(10, 14, 22, 0.78);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.16);
            border-radius: 12px;
        }

        .hud-metric {
            display: flex;
            flex-direction: column;
        }

        .hud-metric-label {
            font-size: 0.65rem;
            font-weight: 700;
            color: var(--text-muted);
            letter-spacing: 0.1em;
            text-transform: uppercase;
        }

        .hud-metric-value {
            font-family: 'Chakra Petch', sans-serif;
            font-size: 1.45rem;
            font-weight: 700;
            line-height: 1.1;
        }

        .hud-quick-buttons {
            display: flex;
            flex-wrap: wrap;
            gap: 6px;
            justify-content: center;
        }

        .hud-btn {
            padding: 8px 12px;
            border-radius: 9px;
            background: rgba(12, 16, 26, 0.82);
            backdrop-filter: blur(8px);
            border: 1px solid rgba(255, 255, 255, 0.2);
            color: #fff;
            font-size: 0.76rem;
            font-weight: 700;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 5px;
            transition: all 0.12s ease;
        }

        .hud-btn:hover {
            background: rgba(255, 255, 255, 0.18);
            border-color: var(--accent);
        }

        .hud-btn.active-state {
            background: rgba(0, 229, 255, 0.25);
            border-color: var(--accent);
            color: var(--accent);
        }

        /* Mini-Map */
        .hud-minimap-box {
            width: 160px;
            height: 160px;
            background: rgba(10, 14, 22, 0.82);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.18);
            border-radius: 14px;
            padding: 8px;
            position: relative;
        }

        #minimap-canvas {
            width: 100%;
            height: 100%;
            border-radius: 8px;
        }

        /* Center Notifications (Countdown, Drift Score, Wrong Way, Achievements) */
        #hud-center-alerts {
            position: absolute;
            top: 22%;
            left: 50%;
            transform: translateX(-50%) scale(var(--hud-scale));
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 8px;
            text-align: center;
            pointer-events: none;
        }

        #countdown-banner {
            font-family: 'Chakra Petch', sans-serif;
            font-size: 5rem;
            font-weight: 800;
            font-style: italic;
            color: #fff;
            text-shadow: 0 0 30px var(--primary-glow), 0 4px 12px rgba(0,0,0,0.8);
            display: none;
        }

        #drift-score-popup {
            padding: 8px 18px;
            border-radius: 99px;
            background: linear-gradient(90deg, rgba(255, 149, 0, 0.85), rgba(255, 59, 48, 0.85));
            font-family: 'Chakra Petch', sans-serif;
            font-weight: 800;
            font-size: 1.2rem;
            box-shadow: 0 4px 20px rgba(255, 149, 0, 0.5);
            display: none;
        }

        #wrong-way-alert {
            padding: 8px 20px;
            border-radius: 8px;
            background: rgba(255, 45, 85, 0.92);
            font-weight: 800;
            font-size: 1.1rem;
            letter-spacing: 0.1em;
            animation: pulseAlert 0.6s infinite alternate;
            display: none;
        }

        @keyframes pulseAlert {
            from { transform: scale(0.96); opacity: 0.85; }
            to { transform: scale(1.04); opacity: 1; }
        }

        /* Bottom Right: Analog/Digital Tachometer, Speedometer, NOS, Interactive Shifter */
        .hud-bottom-right {
            position: absolute;
            bottom: 18px;
            right: 18px;
            display: flex;
            align-items: flex-end;
            gap: 12px;
            transform-origin: bottom right;
            transform: scale(var(--hud-scale));
        }

        .tachometer-widget {
            width: 220px;
            height: 220px;
            position: relative;
            background: radial-gradient(circle at center, rgba(16, 22, 34, 0.92) 55%, rgba(8, 11, 18, 0.96) 100%);
            border: 2px solid rgba(255, 255, 255, 0.18);
            border-radius: 50%;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.65), inset 0 0 20px rgba(0, 229, 255, 0.12);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
        }

        #tacho-canvas {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
        }

        .speed-readout {
            position: relative;
            z-index: 2;
            text-align: center;
            margin-top: 16px;
        }

        .speed-num {
            font-family: 'Chakra Petch', sans-serif;
            font-size: 2.8rem;
            font-weight: 800;
            line-height: 0.95;
            color: #fff;
        }

        .speed-unit {
            font-size: 0.72rem;
            font-weight: 800;
            color: var(--accent);
            letter-spacing: 0.15em;
            cursor: pointer;
        }

        .gear-badge {
            margin-top: 6px;
            width: 34px;
            height: 34px;
            border-radius: 8px;
            background: var(--primary);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-family: 'Chakra Petch', sans-serif;
            font-size: 1.25rem;
            font-weight: 800;
            box-shadow: 0 0 12px var(--primary-glow);
        }

        .nos-and-controls-col {
            display: flex;
            flex-direction: column;
            gap: 8px;
            width: 120px;
        }

        .nos-meter-box {
            padding: 10px;
            border-radius: 12px;
            background: rgba(10, 14, 22, 0.85);
            border: 1px solid rgba(255, 255, 255, 0.16);
        }

        .nos-bar-bg {
            height: 10px;
            background: rgba(255, 255, 255, 0.12);
            border-radius: 99px;
            overflow: hidden;
            margin-top: 5px;
        }

        .nos-bar-fill {
            height: 100%;
            width: 100%;
            background: linear-gradient(90deg, #0072ff, #00e5ff);
            box-shadow: 0 0 10px var(--accent);
            transition: width 0.08s linear;
        }

        /* Bottom Left: Touch / Mouse Driving Controls & Car Status */
        .hud-bottom-left {
            position: absolute;
            bottom: 18px;
            left: 18px;
            display: flex;
            flex-direction: column;
            gap: 10px;
            transform-origin: bottom left;
            transform: scale(var(--hud-scale));
        }

        .car-status-strip {
            display: flex;
            gap: 10px;
            padding: 8px 14px;
            border-radius: 10px;
            background: rgba(10, 14, 22, 0.8);
            border: 1px solid rgba(255, 255, 255, 0.14);
            font-size: 0.74rem;
            font-weight: 700;
        }

        .touch-controls-pad {
            display: flex;
            gap: 12px;
            align-items: center;
        }

        .touch-btn {
            width: 56px;
            height: 56px;
            border-radius: 14px;
            background: rgba(15, 20, 32, 0.82);
            border: 2px solid rgba(255, 255, 255, 0.22);
            color: #fff;
            font-weight: 800;
            font-size: 1.1rem;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            touch-action: manipulation;
        }

        .touch-btn:active, .touch-btn.pressed {
            background: var(--accent);
            color: #060911;
            border-color: #fff;
            transform: scale(0.94);
        }

        .touch-pedal-gas {
